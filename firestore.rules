rules_version = '2';

// ============================================================================
// Friday STM — Firestore Security Rules
// ----------------------------------------------------------------------------
// Paste into: Firebase Console → Firestore Database → Rules → Publish.
// Or deploy with the CLI:  firebase deploy --only firestore:rules
//
// Model:
//   • Students authenticate, READ reference data (geofences, rotations, the
//     week's Senam video) and READ/WRITE only their OWN documents: profile,
//     attendance, Larkam runs, and their own class's Ta'lim summary.
//   • Instructors/Admins get READ access across students for rekap.
//   • Only Admins mutate reference data; only instructors set the Senam video;
//     only class reps submit a Ta'lim summary.
//   • Never trust the client for `valid`/geo — server rules can't verify GPS;
//     tighten with Cloud Functions later if needed.
//
// Role wire values mirror util/Constants.kt → UserRole:
//   student | class_rep | instructor | admin
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Resolve the caller's role from their own profile. Guarded by exists() so a
    // missing profile degrades to 'none' instead of erroring the evaluation.
    // NOTE: each call bills a document read.
    function role() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data.role
        : 'none';
    }

    // Staff = the roles allowed to read across students for rekap.
    // 'instructor' is the wire value in util/Constants.kt → UserRole; there is no
    // 'teacher' role, so testing for it silently reduced isStaff() to isAdmin().
    function isStaff() {
      return isSignedIn() && (role() == 'instructor' || role() == 'admin');
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    /** Class representative — the only role that submits a Ta'lim summary. */
    function isClassRep() {
      return isSignedIn() && role() == 'class_rep';
    }

    /** Instructor — the only role that sets the week's Senam video. */
    function isInstructor() {
      return isSignedIn() && role() == 'instructor';
    }

    // The caller's own class (`users/{uid}.kelas`), or '' when unknown. Used to
    // scope Ta'lim summaries: a class rep may only touch their OWN class's doc.
    // NOTE: each call bills a document read, same as role().
    function myKelas() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data.get('kelas', '')
        : '';
    }

    // Anti-clock-tampering: the incoming write must carry `updatedAt` produced by
    // FieldValue.serverTimestamp(), which Firestore resolves to exactly the
    // `request.time` of this request. A client that substitutes its own device
    // clock (fake "checked in at 06:45") therefore fails this check.
    // Mirrors util/Constants.kt → AttendanceFields.UPDATED_AT.
    function hasServerTime() {
      return request.resource.data.updatedAt == request.time;
    }

    // Bind submitted denormalized identity to the school-provisioned profile.
    // Capture timestamp/GPS are still client claims; createdAt is receipt time.
    function validPresensiCreate() {
      return isSignedIn()
        && role() in ['student', 'class_rep']
        && request.resource.data.userId == uid()
        && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(uid())).data.nama
        && request.resource.data.studentClass == myKelas()
        && request.resource.data.createdAt == request.time;
    }

    // ---- users/{userId} : profiles ---------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isStaff());

      // School identity is provisioned by an existing admin (bootstrap via trusted
      // Admin SDK/console). There is no self-registration flow in this app.
      allow create: if isAdmin()
                    && request.resource.data.uid == userId
                    && request.resource.data.role in ['student', 'class_rep', 'instructor', 'admin'];

      // Self-service never changes identity, grade, class, role or unknown fields.
      allow update: if (isAdmin() && request.resource.data.uid == userId)
                    || (isSignedIn()
                        && uid() == userId
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl', 'fcmToken'])
                        && request.resource.data.get('photoUrl', '') is string
                        && request.resource.data.get('fcmToken', '') is string);

      allow delete: if isAdmin();
    }

    // ---- geofences/{id} : reference data, read-only for students ---------
    match /geofences/{geofenceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- rotations/{scheduleId} : reference data, read-only for students -
    match /rotations/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- attendance/{uid_date} : one doc per student per day -------------
    match /attendance/{docId} {
      // `resource` is null for a doc that does not exist yet, and dereferencing
      // null denies the read — so short-circuit first. Allowing the miss leaks
      // nothing (there is no data), and the owner's listener attaches at 06:30
      // before the first check-in creates the document.
      allow read: if isSignedIn()
                  && (resource == null || resource.data.uid == uid() || isStaff());

      function validCheckin() {
        return request.resource.data.grade == get(/databases/$(database)/documents/users/$(uid())).data.grade
          && request.resource.data.pembiasaan.checkedIn == true
          && request.resource.data.pembiasaan.serverTime == request.time;
      }

      // A new day starts with check-in only; complete/checkout cannot be forged
      // in the first write. Nested phase receipt times are server-authored too.
      allow create: if isSignedIn()
                    && role() in ['student', 'class_rep']
                    && request.resource.data.uid == uid()
                    && docId == uid() + '_' + request.resource.data.date
                    && request.resource.data.keys().hasOnly(['uid', 'date', 'grade', 'pembiasaan', 'status', 'updatedAt'])
                    && request.resource.data.get('status', 'incomplete') == 'incomplete'
                    && validCheckin()
                    && hasServerTime();

      // Preserve historical fields (including legacy apel) and phase evidence.
      // Only an unfilled check-in OR checkout following a persisted check-in may
      // advance the day. A completed/flagged day cannot be rewritten by clients.
      allow update: if isSignedIn()
                    && role() in ['student', 'class_rep']
                    && resource.data.uid == uid()
                    && request.resource.data.uid == uid()
                    && request.resource.data.date == resource.data.date
                    && docId == uid() + '_' + resource.data.date
                    && resource.data.get('status', 'incomplete') == 'incomplete'
                    && resource.data.get('checkout', null) == null
                    && hasServerTime()
                    && ((resource.data.get('pembiasaan', null) == null
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grade', 'pembiasaan', 'updatedAt'])
                         && validCheckin())
                        || (resource.data.pembiasaan.checkedIn == true
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkout', 'status', 'updatedAt'])
                            && request.resource.data.checkout.checkedOut == true
                            && request.resource.data.checkout.serverTime == request.time
                            && request.resource.data.status == 'complete'));

      // Attendance is an audit trail — never client-deletable. Corrections go
      // through admin tooling / the console.
      allow delete: if false;
    }

    // ---- talim_summaries/{date_kelas} : one summary per class per Friday ----
    // Written by the class rep for their OWN class; read by that class + staff.
    match /talim_summaries/{docId} {
      // Same null short-circuit as attendance: observeSummary attaches before the
      // rep has submitted, so a missing document must not be a denial.
      allow read: if isSignedIn()
                  && (resource == null || resource.data.kelas == myKelas() || isStaff());

      // Deterministic id enforces `${date}_${kelas}` (TalimSummary.docIdFor), so a
      // rep cannot file a summary under another class's slot or forge the author.
      allow create, update: if isAdmin()
                            || (isClassRep()
                                && request.resource.data.kelas == myKelas()
                                && request.resource.data.submittedByUid == uid()
                                && docId == request.resource.data.date + '_' + request.resource.data.kelas);

      // Corrections go through admin tooling, not the client.
      allow delete: if isAdmin();
    }

    // ---- senam_sessions/{weekId} : the week's video, instructor-managed ----
    match /senam_sessions/{weekId} {
      // Reference data: every signed-in user follows the routine on Home.
      allow read: if isSignedIn();

      allow create, update: if isAdmin()
                            || (isInstructor()
                                && request.resource.data.setByUid == uid()
                                && request.resource.data.weekId == weekId);

      allow delete: if isAdmin();
    }

    // ---- larkam_runs/{runId} : append-only run log (auto-id) --------------
    // Append-only & strictly per-user isolated: a run is readable/writable only by
    // its owner. No staff bypass, no cross-user reads — enforced at the rule layer.
    match /larkam_runs/{runId} {
      allow read: if isSignedIn() && resource.data.userId == uid();

      // Owner field cannot be forged — create succeeds only when the new doc's
      // userId equals the authenticated uid.
      allow create: if isSignedIn() && request.resource.data.userId == uid();

      // A finished run is evidence — never client-editable or client-deletable.
      allow update, delete: if false;
    }

    // ---- larkam_records/{docId} : selfie-finish Larkam (auto-id) -----------
    // Ditulis `PresensiCameraViewModel` saat finish selfie Larkam (berisi
    // `distanceKm`, …). Append-only milik sendiri; dibaca pemilik untuk
    // agregat statistik Profil dan oleh guru/admin untuk dashboard monitoring.
    // Koreksi via admin tooling.
    match /larkam_records/{docId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow read: if isSignedIn() && (resource.data.userId == uid() || isStaff());
      allow update, delete: if false;
    }

    // ---- presensi/{docId} : alias legacy for presensi_records (spec wording) ---
    // Allows teacher dashboard spec collection `presensi` filtered by kelas/tanggal.
    match /presensi/{docId} {
      allow create: if validPresensiCreate();
      allow read: if isSignedIn() && (resource.data.userId == uid() || isStaff());
      allow update, delete: if false;
    }

    // ---- presensi_records/{docId} : watermarked selfie presensi ------------
    match /presensi_records/{docId} {
      allow create: if validPresensiCreate();
      allow read: if isSignedIn() && (resource.data.userId == uid() || isStaff());
      allow update, delete: if false;
    }

    // ---- izin_records/{docId} : pengajuan izin/sakit (auto-id) ---------------
    // Siswa membuat pengajuan miliknya sendiri (status awal wajib PENDING,
    // owner field tak boleh dipalsukan); membaca hanya miliknya sendiri.
    // Staf (guru/admin) membaca lintas siswa untuk rekap/verifikasi; kabar
    // persetujuan (APPROVED/REJECTED) hanya lewat staf/admin tooling.
    match /izin_records/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && request.resource.data.status == 'PENDING';
      allow read: if isSignedIn()
                  && (resource.data.userId == uid() || isStaff());
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Anything not matched above is denied by default.
  }
}
