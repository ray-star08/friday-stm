rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /presensi_selfies/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Bukti surat pengajuan izin/sakit: `permits/{userId}_{epochMillis}.jpg`.
    // Tulis milik sendiri; baca oleh pemilik + staf (verifikasi via Firestore rules).
    match /permits/{fileName} {
      allow write: if request.auth != null && fileName.matches(request.auth.uid + '_.*');
      allow read: if request.auth != null;
    }
  }
}
